# AFNIC Phoenix API
# Environnement : sandbox | production
AFNIC_ENV=sandbox

# URLs (optionnel — déduites automatiquement de AFNIC_ENV si omises)
# sandbox  -> api-sandbox.nic.fr / login-sandbox.nic.fr
# production -> api.nic.fr / login.nic.fr
# AFNIC_API_BASE_URL=
# KEYCLOAK_TOKEN_URL=
# EXTRANET_BASE_URL=
# Identifiants registrar AFNIC (côté serveur uniquement — jamais exposés aux clients)
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=

# Client OAuth Keycloak — ne pas confondre avec votre identifiant extranet
KEYCLOAK_CLIENT_ID=registrars-api-client

# E-mails des administrateurs (séparés par des virgules)
ADMIN_EMAILS=you@example.fr

# Identifiants registrar optionnels par environnement
# KEYCLOAK_USERNAME_SANDBOX=
# KEYCLOAK_PASSWORD_SANDBOX=
# KEYCLOAK_USERNAME_PRODUCTION=
# KEYCLOAK_PASSWORD_PRODUCTION=

# Set to true to run without AFNIC credentials (simulated responses)
MOCK_AFNIC=true

# Backend
PORT=3001
DATABASE_URL=postgres://afnic:afnic@localhost:5432/afnic
DOMAIN_CHECK_CHUNK_SIZE=7
AUTO_APPEND_FR_SUFFIX=true
SESSION_SECRET=change-me-in-production
FRONTEND_ORIGIN=http://localhost:5173
